<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
  </ItemGroup>

  <!-- Debug builds only: remember where the project lives so the running app can watch
       the local.settings.json you edit rather than the copy in bin/. Release builds carry
       no path. See LocalDev/LocalSettingsFile.cs. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="LocalSettingsDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalRoles.Functions.Tests" />
  </ItemGroup>

</Project>
